cmake_minimum_required(VERSION 3.24)
if (NOT DEFINED REPO_ROOT)
    get_filename_component(REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif ()
get_filename_component(REPO_ROOT "${REPO_ROOT}" ABSOLUTE)

function(check_lines pattern ceiling)
    file(GLOB _files "${REPO_ROOT}/${pattern}")
    foreach(_file IN LISTS _files)
        file(READ "${_file}" _content)
        string(REGEX MATCHALL "\n" _nls "${_content}")
        list(LENGTH _nls _lines)
        if (NOT _content STREQUAL "" AND NOT _content MATCHES "\n$")
            math(EXPR _lines "${_lines} + 1")
        endif ()
        if (_lines GREATER ceiling)
            message(FATAL_ERROR "${_file}: line-count ceiling ${ceiling} exceeded (${_lines})")
        endif ()
    endforeach()
endfunction()
check_lines("src/*.cpp" 4000)
check_lines("include/etch/*.h" 2500)
check_lines("examples/*.cpp" 3200)

set(_total_core_loc 0)
file(GLOB _core_loc_files
    "${REPO_ROOT}/include/etch/*.h"
    "${REPO_ROOT}/src/*.cpp"
    "${REPO_ROOT}/src/*.h"
    "${REPO_ROOT}/shaders/*.hlsl")
foreach(_file IN LISTS _core_loc_files)
    file(READ "${_file}" _content)
    string(REGEX MATCHALL "\n" _nls "${_content}")
    list(LENGTH _nls _lines)
    if (NOT _content STREQUAL "" AND NOT _content MATCHES "\n$")
        math(EXPR _lines "${_lines} + 1")
    endif ()
    math(EXPR _total_core_loc "${_total_core_loc} + ${_lines}")
endforeach()
if (_total_core_loc GREATER 30000)
    message(FATAL_ERROR "${REPO_ROOT}: total core engine LOC ceiling 30000 exceeded (${_total_core_loc})")
endif ()

file(GLOB_RECURSE _example_headers "${REPO_ROOT}/examples/*.h" "${REPO_ROOT}/examples/*.hpp")
file(GLOB _root_pngs "${REPO_ROOT}/*.png")
file(GLOB_RECURSE _vectors "${REPO_ROOT}/include/*.vectors.png" "${REPO_ROOT}/src/*.vectors.png"
    "${REPO_ROOT}/examples/*.vectors.png" "${REPO_ROOT}/tests/*.vectors.png")
foreach(_file IN LISTS _example_headers _root_pngs _vectors)
    message(FATAL_ERROR "${_file}: directory/artifact hygiene forbids example headers, root PNGs and source-tree *.vectors.png")
endforeach()

function(forbid file content regex rule)
    if ("${content}" MATCHES "${regex}")
        message(FATAL_ERROR "${file}: ${rule}; offending match: ${CMAKE_MATCH_0}")
    endif ()
endfunction()

file(GLOB _public "${REPO_ROOT}/include/etch/*.h")
foreach(_file IN LISTS _public)
    file(READ "${_file}" _content)
    forbid("${_file}" "${_content}" "inject_" "public headers must not expose injection hooks")
    forbid("${_file}" "${_content}" "#[ \t]*include[ \t]*[<\"][^>\"\r\n]*(etch_testing\\.h|clay\\.h|stb_|hb\\.h|hb-)" "public headers must not include private dependencies")
    forbid("${_file}" "${_content}" "#[ \t]*include[ \t]*<(vector|string|memory|functional|optional|variant|expected|exception|stdexcept|typeinfo|iostream)>" "public header STL purity")
endforeach()

file(GLOB _cpp_files "${REPO_ROOT}/src/*.cpp" "${REPO_ROOT}/examples/*.cpp"
    "${REPO_ROOT}/tests/*.cpp" "${REPO_ROOT}/tests/*.h"
    "${REPO_ROOT}/tests/*.c" "${REPO_ROOT}/tests/consumer_smoke/*.c"
    "${REPO_ROOT}/tests/consumer_smoke/*.cpp")
file(GLOB _orthodox ${_public} "${REPO_ROOT}/src/*.cpp" "${REPO_ROOT}/src/*.h"
    "${REPO_ROOT}/examples/*.cpp" "${REPO_ROOT}/tests/*.cpp" "${REPO_ROOT}/tests/*.h"
    "${REPO_ROOT}/tests/consumer_smoke/*.cpp")
foreach(_file IN LISTS _orthodox)
    file(READ "${_file}" _content)
    forbid("${_file}" "${_content}" "#[ \t]*include[ \t]*<(vector|string|memory|functional|optional|variant|expected|exception|stdexcept|typeinfo)>" "Orthodox C++20 forbids this STL header")
    forbid("${_file}" "${_content}" "dynamic_cast[ \t\r\n]*<|typeid[ \t]*\\(" "Orthodox C++20 forbids RTTI")
endforeach()

file(READ "${REPO_ROOT}/CMakeLists.txt" _cmake)
if (NOT _cmake MATCHES "project\\(etch[ \t]+VERSION[ \t]+([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    message(FATAL_ERROR "CMakeLists.txt: missing project(etch VERSION major.minor.patch)")
endif ()
set(_maj "${CMAKE_MATCH_1}")
set(_min "${CMAKE_MATCH_2}")
set(_pat "${CMAKE_MATCH_3}")
file(READ "${REPO_ROOT}/include/etch/etch.h" _header)
foreach(_part MAJOR MINOR PATCH)
    if (NOT _header MATCHES "#define[ \t]+ETCH_VERSION_${_part}[ \t]+([0-9]+)")
        message(FATAL_ERROR "include/etch/etch.h: missing ETCH_VERSION_${_part}")
    endif ()
    set(_header_${_part} "${CMAKE_MATCH_1}")
endforeach()
if (NOT "${_maj}.${_min}.${_pat}" STREQUAL "${_header_MAJOR}.${_header_MINOR}.${_header_PATCH}")
    message(FATAL_ERROR "include/etch/etch.h: ETCH_VERSION_* disagrees with CMakeLists.txt project VERSION ${_maj}.${_min}.${_pat}")
endif ()

set(_c_header_path "${REPO_ROOT}/include/etch/etch_c.h")
if (NOT EXISTS "${_c_header_path}")
    message(FATAL_ERROR "include/etch/etch_c.h: pure C99 public header is missing")
endif ()
file(READ "${_c_header_path}" _c_header)
foreach(_part MAJOR MINOR PATCH)
    if (NOT _c_header MATCHES "#define[ \t]+ETCH_VERSION_${_part}[ \t]+([0-9]+)")
        message(FATAL_ERROR "include/etch/etch_c.h: missing ETCH_VERSION_${_part}")
    endif ()
    set(_c_header_${_part} "${CMAKE_MATCH_1}")
endforeach()
if (NOT "${_maj}.${_min}.${_pat}" STREQUAL "${_c_header_MAJOR}.${_c_header_MINOR}.${_c_header_PATCH}")
    message(FATAL_ERROR "include/etch/etch_c.h: ETCH_VERSION_* disagrees with CMakeLists.txt project VERSION ${_maj}.${_min}.${_pat}")
endif ()
string(REGEX MATCHALL "#[ \t]*include[^\r\n]*" _c_includes "${_c_header}")
foreach(_inc IN LISTS _c_includes)
    if (NOT "${_inc}" MATCHES "^#[ \t]*include[ \t]*<(stdbool|stddef|stdint)\\.h>[ \t]*$")
        message(FATAL_ERROR "include/etch/etch_c.h: pure C99 header may only include <stdbool.h>, <stddef.h>, <stdint.h>; offending line: ${_inc}")
    endif ()
endforeach()

foreach(_name LICENSE THIRD_PARTY_NOTICES.md README.md CHANGELOG.md CLAUDE.md AGENTS.md)
    if (NOT EXISTS "${REPO_ROOT}/${_name}")
        message(FATAL_ERROR "${_name}: required OSS governance file is missing")
    endif ()
    file(SIZE "${REPO_ROOT}/${_name}" _size)
    if (_size EQUAL 0)
        message(FATAL_ERROR "${_name}: required OSS governance file is empty")
    endif ()
endforeach()
file(READ "${REPO_ROOT}/CHANGELOG.md" _changelog)
string(FIND "${_changelog}" "## [${_maj}.${_min}.${_pat}]" _release)
if (_release EQUAL -1)
    message(FATAL_ERROR "CHANGELOG.md: missing ## [${_maj}.${_min}.${_pat}]")
endif ()
foreach(_file IN LISTS _cpp_files)
    file(READ "${_file}" _content)
    forbid("${_file}" "${_content}" "\"(ETCH v[0-9]|ETCH [0-9]+\\.[0-9]+|Etch v[0-9]|Etch [0-9]+\\.[0-9]+|Etch Studio [0-9]+\\.[0-9]+|v[0-9]+\\.[0-9]+ )" "use ETCH_VERSION_STRING instead of hardcoded version strings")
endforeach()
file(READ "${REPO_ROOT}/THIRD_PARTY_NOTICES.md" _notices)
file(GLOB _dependencies LIST_DIRECTORIES true "${REPO_ROOT}/third_party/*")
foreach(_entry IN LISTS _dependencies)
    get_filename_component(_name "${_entry}" NAME)
    if (_name MATCHES "^\\." OR _name STREQUAL "dxc")
        continue()
    endif ()
    string(FIND "${_notices}" "third_party/${_name}" _notice)
    if (_notice EQUAL -1)
        message(FATAL_ERROR "THIRD_PARTY_NOTICES.md: missing notice coverage for third_party/${_name}")
    endif ()
endforeach()
message(STATUS "Repository guardrails passed")
