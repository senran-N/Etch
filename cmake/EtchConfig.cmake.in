@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(SDL3 CONFIG REQUIRED)
if ("@ETCH_INSTALL_HB_MODE@" STREQUAL "CONFIG")
    find_dependency(harfbuzz CONFIG REQUIRED)
elseif ("@ETCH_INSTALL_HB_MODE@" STREQUAL "PKGCONFIG")
    find_package(PkgConfig QUIET)
    if (PkgConfig_FOUND)
        pkg_check_modules(HARFBUZZ QUIET IMPORTED_TARGET harfbuzz)
    endif ()
    if (NOT TARGET PkgConfig::HARFBUZZ)
        set(Etch_FOUND FALSE)
        set(Etch_NOT_FOUND_MESSAGE "Etch requires HarfBuzz discoverable through pkg-config.")
        return()
    endif ()
endif ()
if ("@ETCH_INSTALL_FT_MODE@" STREQUAL "FIND_PACKAGE")
    find_dependency(Freetype REQUIRED)
elseif ("@ETCH_INSTALL_FT_MODE@" STREQUAL "PKGCONFIG")
    find_package(PkgConfig QUIET)
    if (PkgConfig_FOUND)
        pkg_check_modules(FREETYPE QUIET IMPORTED_TARGET freetype2)
    endif ()
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/EtchTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/EtchShaderTools.cmake")
check_required_components(Etch)
