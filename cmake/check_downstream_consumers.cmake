cmake_minimum_required(VERSION 3.24)
include("${CFG_FILE}")
set(WORK_DIR "${ETCH_TEST_BUILD_DIR}/_consumer_check")
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
if (CMAKE_HOST_WIN32)
    set(_exe ".exe")
else ()
    set(_exe "")
endif ()

# Each forwarded value stays one argument, including paths containing spaces/lists.
function(forward_arg option value)
    if (NOT "${value}" STREQUAL "")
        string(REPLACE ";" "\\;" _value "${value}")
        if (option MATCHES "^-D")
            list(APPEND _configure_args "${option}=${_value}")
        else ()
            list(APPEND _configure_args "${option}" "${_value}")
        endif ()
        set(_configure_args "${_configure_args}" PARENT_SCOPE)
    endif ()
endfunction()
forward_arg(-G "${ETCH_TEST_GENERATOR}")
forward_arg(-A "${ETCH_TEST_GENERATOR_PLATFORM}")
forward_arg(-T "${ETCH_TEST_GENERATOR_TOOLSET}")
forward_arg(-DCMAKE_MAKE_PROGRAM "${ETCH_TEST_MAKE_PROGRAM}")
forward_arg(-DCMAKE_BUILD_TYPE "${CONFIG}")
forward_arg(-DCMAKE_C_COMPILER "${ETCH_TEST_C_COMPILER}")
forward_arg(-DCMAKE_CXX_COMPILER "${ETCH_TEST_CXX_COMPILER}")
forward_arg(-DCMAKE_TOOLCHAIN_FILE "${ETCH_TEST_TOOLCHAIN_FILE}")
forward_arg(-DVCPKG_TARGET_TRIPLET "${ETCH_TEST_VCPKG_TRIPLET}")
forward_arg(-DSDL3_DIR "${ETCH_TEST_SDL3_DIR}")
forward_arg(-Dharfbuzz_DIR "${ETCH_TEST_HARFBUZZ_DIR}")
forward_arg(-DCMAKE_OSX_ARCHITECTURES "${ETCH_TEST_OSX_ARCHITECTURES}")
forward_arg(-DCMAKE_OSX_SYSROOT "${ETCH_TEST_OSX_SYSROOT}")
forward_arg(-DCMAKE_OSX_DEPLOYMENT_TARGET "${ETCH_TEST_OSX_DEPLOYMENT_TARGET}")
set(_config_args)
if (NOT "${CONFIG}" STREQUAL "")
    list(APPEND _config_args --config "${CONFIG}")
endif ()

function(run_checked)
    set(_command)
    math(EXPR _last "${ARGC} - 1")
    foreach(_index RANGE 0 ${_last})
        string(REPLACE ";" "\\;" _argument "${ARGV${_index}}")
        list(APPEND _command "${_argument}")
    endforeach()
    execute_process(COMMAND ${_command} RESULT_VARIABLE _result)
    if (NOT "${_result}" STREQUAL "0")
        message(FATAL_ERROR "Downstream command failed (${_result}): ${ARGV}\nDiagnostics retained in ${WORK_DIR}")
    endif ()
endfunction()

run_checked("${CMAKE_COMMAND}" --install "${ETCH_TEST_BUILD_DIR}" --prefix "${WORK_DIR}/install" ${_config_args})
set(_incdir "${ETCH_TEST_INSTALL_INCLUDEDIR}")
if ("${_incdir}" STREQUAL "")
    set(_incdir "include")
endif ()
cmake_path(IS_ABSOLUTE _incdir _incdir_absolute)
if (_incdir_absolute)
    set(_installed_header "${_incdir}/etch/etch.h")
    set(_installed_c_header "${_incdir}/etch/etch_c.h")
else ()
    set(_installed_header "${WORK_DIR}/install/${_incdir}/etch/etch.h")
    set(_installed_c_header "${WORK_DIR}/install/${_incdir}/etch/etch_c.h")
endif ()
if (NOT EXISTS "${_installed_header}")
    message(FATAL_ERROR "Installed public header missing: ${_installed_header}")
endif ()
if (NOT EXISTS "${_installed_c_header}")
    message(FATAL_ERROR "Installed public C99 header missing: ${_installed_c_header}")
endif ()
file(GLOB_RECURSE _private_headers "${WORK_DIR}/install/*etch_testing.h")
if (_private_headers)
    message(FATAL_ERROR "Installed private headers: ${_private_headers}")
endif ()
file(GLOB_RECURSE _exports "${WORK_DIR}/install/*EtchTargets.cmake")
if (NOT _exports)
    message(FATAL_ERROR "${WORK_DIR}/install: missing EtchTargets.cmake")
endif ()
foreach(_export IN LISTS _exports)
    file(READ "${_export}" _content)
    string(FIND "${_content}" "$<LINK_ONLY:>" _empty_link)
    if (NOT _empty_link EQUAL -1)
        message(FATAL_ERROR "${_export}: empty $<LINK_ONLY:> in installed interface")
    endif ()
endforeach()

# Shared target setup is emitted into each independent consumer project.
set(_target_setup [=[
add_executable(@TARGET@ "@ETCH_TEST_REPO_ROOT@/tests/consumer_smoke/main.cpp")
target_compile_features(@TARGET@ PRIVATE cxx_std_20)
set_target_properties(@TARGET@ PROPERTIES CXX_EXTENSIONS OFF)
if (CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC" OR (NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT AND MSVC))
    string(REPLACE "/EHsc" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
    target_compile_options(@TARGET@ PRIVATE /W4 /WX /permissive- /utf-8 /GR- /EHs-c-)
    target_compile_definitions(@TARGET@ PRIVATE _HAS_EXCEPTIONS=0)
else ()
    target_compile_options(@TARGET@ PRIVATE -Wall -Wextra -Wpedantic -Werror -fno-exceptions -fno-rtti)
endif ()
target_link_libraries(@TARGET@ PRIVATE Etch::etch)
set_target_properties(@TARGET@ PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_RELEASE "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_DEBUG "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_RELWITHDEBINFO "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_MINSIZEREL "@BIN_DIR@")
if (WIN32)
    add_custom_command(TARGET @TARGET@ POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E $<IF:$<BOOL:$<TARGET_RUNTIME_DLLS:@TARGET@>>,copy_if_different,true>
                $<TARGET_RUNTIME_DLLS:@TARGET@>
                $<$<BOOL:$<TARGET_RUNTIME_DLLS:@TARGET@>>:$<TARGET_FILE_DIR:@TARGET@>>
        COMMAND_EXPAND_LISTS VERBATIM)
endif ()

add_executable(@TARGET@_c "@ETCH_TEST_REPO_ROOT@/tests/consumer_smoke/main_c.c")
set_target_properties(@TARGET@_c PROPERTIES
    C_STANDARD 99
    C_STANDARD_REQUIRED ON
    C_EXTENSIONS OFF)
if (CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC" OR (NOT CMAKE_C_COMPILER_FRONTEND_VARIANT AND MSVC))
    target_compile_options(@TARGET@_c PRIVATE /W4 /WX /permissive- /utf-8)
else ()
    target_compile_options(@TARGET@_c PRIVATE -Wall -Wextra -Wpedantic -Werror)
endif ()
target_link_libraries(@TARGET@_c PRIVATE Etch::etch)
set_target_properties(@TARGET@_c PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_RELEASE "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_DEBUG "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_RELWITHDEBINFO "@BIN_DIR@"
    RUNTIME_OUTPUT_DIRECTORY_MINSIZEREL "@BIN_DIR@")
if (WIN32)
    add_custom_command(TARGET @TARGET@_c POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E $<IF:$<BOOL:$<TARGET_RUNTIME_DLLS:@TARGET@_c>>,copy_if_different,true>
                $<TARGET_RUNTIME_DLLS:@TARGET@_c>
                $<$<BOOL:$<TARGET_RUNTIME_DLLS:@TARGET@_c>>:$<TARGET_FILE_DIR:@TARGET@_c>>
        COMMAND_EXPAND_LISTS VERBATIM)
endif ()
]=])
set(_find_prelude [=[
cmake_minimum_required(VERSION 3.24)
project(EtchFindConsumer LANGUAGES C CXX)
find_package(Etch @ETCH_TEST_VERSION_MM@ CONFIG REQUIRED)
]=])
set(_sub_prelude [=[
cmake_minimum_required(VERSION 3.24)
project(EtchSubConsumer LANGUAGES C CXX)
set(ETCH_COMPILE_SHADERS OFF CACHE BOOL "" FORCE)
add_subdirectory("@ETCH_TEST_REPO_ROOT@" etch_sub)
foreach(_option ETCH_BUILD_EXAMPLES ETCH_BUILD_TESTS ETCH_INSTALL)
    get_directory_property(_value DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/etch_sub" DEFINITION ${_option})
    if (_value)
        message(FATAL_ERROR "${_option} must default to OFF for subprojects")
    endif ()
endforeach()
if (TARGET sandbox OR TARGET etch_studio OR TARGET etch_tests OR TARGET etch_c_abi_tests)
    message(FATAL_ERROR "Etch subproject created example/test targets by default")
endif ()
]=])
set(_prefix "${WORK_DIR}/install")
if (NOT "${ETCH_TEST_PREFIX_PATH}" STREQUAL "")
    list(APPEND _prefix ${ETCH_TEST_PREFIX_PATH})
endif ()
forward_arg(-DCMAKE_PREFIX_PATH "${_prefix}")
foreach(_phase find_pkg add_sub)
    if (_phase STREQUAL "find_pkg")
        set(TARGET consumer_find)
        set(_prelude "${_find_prelude}")
    else ()
        set(TARGET consumer_sub)
        set(_prelude "${_sub_prelude}")
    endif ()
    set(BIN_DIR "${WORK_DIR}/${_phase}/bin")
    string(CONFIGURE "${_prelude}${_target_setup}" _project @ONLY)
    file(MAKE_DIRECTORY "${WORK_DIR}/${_phase}")
    file(WRITE "${WORK_DIR}/${_phase}/CMakeLists.txt" "${_project}")
    run_checked("${CMAKE_COMMAND}" -S "${WORK_DIR}/${_phase}" -B "${WORK_DIR}/${_phase}/build" ${_configure_args})
    run_checked("${CMAKE_COMMAND}" --build "${WORK_DIR}/${_phase}/build" --parallel ${_config_args})
    run_checked("${BIN_DIR}/${TARGET}${_exe}")
    run_checked("${BIN_DIR}/${TARGET}_c${_exe}")
endforeach()
file(REMOVE_RECURSE "${WORK_DIR}")
message(STATUS "Installed and add_subdirectory consumers passed")
