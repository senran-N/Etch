# Match the checked-in offline Metal byte arrays, including the trailing NUL.
file(READ "${IN}" _hex HEX)
string(REGEX MATCHALL ".." _bytes "${_hex}")
set(_header "// Offline Metal 2.1 source.\nconst unsigned char ${VAR}[] = {\n    ")
set(_column 0)
foreach(_byte IN LISTS _bytes)
    string(APPEND _header "0x${_byte},")
    math(EXPR _column "${_column} + 1")
    if (_column EQUAL 24)
        string(APPEND _header "\n    ")
        set(_column 0)
    else ()
        string(APPEND _header " ")
    endif ()
endforeach ()
string(APPEND _header "0x00\n};\n")
file(WRITE "${OUT}" "${_header}")
